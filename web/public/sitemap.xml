<?xml version="1.0" encoding="UTF-8"?>
<!--
  URLs here are the extensionless ones Cloudflare Pages actually serves.
  Listing /manual.html instead would hand Google a 308 to /manual on every
  entry - a sitemap is meant to name the canonical URL, not a redirect to it.
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url>
    <loc>https://flugvel.com/</loc>
    <changefreq>monthly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>https://flugvel.com/manual</loc>
    <changefreq>monthly</changefreq>
    <priority>0.8</priority>
  </url>
  <url>
    <loc>https://flugvel.com/privacy</loc>
    <changefreq>yearly</changefreq>
    <priority>0.3</priority>
  </url>
</urlset>
